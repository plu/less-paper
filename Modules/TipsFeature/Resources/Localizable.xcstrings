    "tipsExplanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dir Less Paper nützt, kannst du Trinkgeld dalassen. Es schaltet nichts frei – alle Funktionen sind ohnehin da."
