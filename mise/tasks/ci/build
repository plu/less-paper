#!/usr/bin/env bash
#MISE description="Build LessPaper.ipa"
set -euo pipefail

# Copied from https://github.com/tuist/tuist/blob/main/mise/tasks/app/bundle-ios.sh

TMP_DIR=/private$(mktemp -d)
EXPORT_OPTIONS_PLIST_PATH=$TMP_DIR/ExportOptions.plist

trap "rm -rf $TMP_DIR" EXIT # Delete on exit

if [ "${CI:-}" = "true" ]; then
    echo "Creating a temporary keychain"
    KEYCHAIN_PASSWORD=$(uuidgen)
    KEYCHAIN_PATH=$TMP_DIR/temp.keychain
    security create-keychain -p $KEYCHAIN_PASSWORD $KEYCHAIN_PATH
    security set-keychain-settings -lut 21600 $KEYCHAIN_PATH
    security unlock-keychain -p $KEYCHAIN_PASSWORD $KEYCHAIN_PATH
    security list-keychains -s $KEYCHAIN_PATH $HOME/Library/Keychains/login.keychain-db
	printf '%s' "$DISTRIBUTION_CERTIFICATE" | base64 -d > $TMP_DIR/distribution.p12
	security import $TMP_DIR/distribution.p12 -A -P "" -k $KEYCHAIN_PATH
fi

mkdir -p "$HOME/Library/MobileDevice/Provisioning Profiles"
printf '%s' "$APP_PROVISIONING_PROFILE" | base64 -d > "$HOME/Library/MobileDevice/Provisioning Profiles/com.aptumtek.app.Paperless.mobileprovision"
printf '%s' "$SHARE_EXTENSION_PROVISIONING_PROFILE" | base64 -d > "$HOME/Library/MobileDevice/Provisioning profiles/com.aptumtek.app.Paperless.ShareExtension.mobileprovision"

cat << EOF > "$EXPORT_OPTIONS_PLIST_PATH"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>destination</key>
	<string>export</string>
	<key>method</key>
	<string>app-store-connect</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.aptumtek.app.Paperless</key>
		<string>com.aptumtek.app.Paperless</string>
		<key>com.aptumtek.app.Paperless.ShareExtension</key>
		<string>com.aptumtek.app.Paperless.ShareExtension</string>
	</dict>
	<key>signingCertificate</key>
	<string>Apple Distribution: Johannes Plunien (HZ7YVCSB89)</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>teamID</key>
	<string>HZ7YVCSB89</string>
	<key>thinning</key>
	<string>&lt;none&gt;</string>
</dict>
</plist>
EOF

export TUIST_APP_PROVISIONING_PROFILE=com.aptumtek.app.Paperless
export TUIST_BUILD_IPA=true
export TUIST_SHARE_EXTENSION_PROVISIONING_PROFILE=com.aptumtek.app.Paperless.ShareExtension

tuist generate --no-binary-cache --no-open
tuist xcodebuild archive clean -archivePath $TMP_DIR/LessPaper.xcarchive -workspace LessPaper.xcworkspace -scheme "Less Paper" -configuration Release -destination "generic/platform=iOS" CODE_SIGN_IDENTITY="Apple Distribution: Johannes Plunien (HZ7YVCSB89)" CODE_SIGN_STYLE="Manual" CODE_SIGN_INJECT_BASE_ENTITLEMENTS="NO"
xcodebuild -exportArchive -archivePath $TMP_DIR/LessPaper.xcarchive -exportOptionsPlist $EXPORT_OPTIONS_PLIST_PATH -exportPath $TMP_DIR
mkdir -p build
cp $TMP_DIR/LessPaper.ipa build/LessPaper.ipa

# Telemetry, not a gate: an unreachable Tuist server or an unauthenticated local run must not fail
# a build that has already produced the ipa. Build insights need nothing here - tuist xcodebuild
# archive uploads its own build run.
tuist inspect bundle build/LessPaper.ipa || echo "warning: bundle inspection failed"
