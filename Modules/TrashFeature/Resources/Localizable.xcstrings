    "trashDeleteForever": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete forever"
          }
        }
      }
    },
    "trashDeleteForeverMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird „%@“ endgültig entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes “%@” for good. It cannot be undone."
          }
        }
      }
    },
    "trashDeletedAt": {
      "extractionState": "manual",
      "localizations": {
