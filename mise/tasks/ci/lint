#!/usr/bin/env bash
#MISE description="Lint code"
set -eou pipefail
swiftformat --lint . --reporter github-actions-log
swiftlint --reporter github-actions-logging --strict --quiet
"$MISE_PROJECT_ROOT/mise/scripts/attribute_blank_lines.py" --check
python3 -m unittest discover -s "$MISE_PROJECT_ROOT/mise/scripts" -p "test_*.py"
tuist install
tuist inspect dependencies --only implicit
