# Apple requires one 6.9" iPhone set, and a 13" iPad set for an app that runs on iPad. Everything
# smaller is scaled from these by App Store Connect, so these two are the whole matrix.
devices([
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M5)"
])

# Pinned for the same reason mise/scripts/run_tests.sh passes `-o`: a machine carrying two iOS
# runtimes has both of these device names twice, and an unpinned run lets fastlane pick. It would
# capture at the wrong system-UI vintage and go green doing it. Read from mise.toml rather than
# written out, so it cannot drift from the runtime the snapshot tests record on.
ios_version(ENV.fetch("TEST_SIMULATOR_OS"))

languages([
  "en-US",
  "de-DE"
])

# Named rather than detected: fastlane looks for a project in the working directory, and the
# workspace is generated by tuist, so it is absent until ci:screenshots:capture has run generate.
workspace("LessPaper.xcworkspace")

scheme("Snapshots")

output_directory("./Screenshots/Captures")

# Cleared by the screenshots lane instead, so a subset - one language, one device - can be
# recaptured without deleting the rest. A stale image is still always wrong: the lane clears
# everything when it runs the full matrix.
clear_previous_screenshots(false)

# 9:41, full bars, full battery, instead of whatever the simulator clock happens to read.
override_status_bar(true)

concurrent_simulators(false)

# -collect-test-diagnostics never for the reason spelled out in mise/scripts/run_tests.sh. The
# capture runs the matrix four times over, so a single failing device-language pair would otherwise
# add ten minutes to a lane that already takes the longest of any here.
xcargs("-collect-test-diagnostics never")

# The preview choreography lives in the same target because it needs the same fixtures and the same
# navigation. It captures nothing, so a screenshot run would spend two minutes on it four times over
# - twice per device, twice per language - for no image.
skip_testing(["AppSnapshots/AppPreviewTests"])
