      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist scheinbar mit einem Passwort geschützt. Der Import in Paperless funktioniert wenn du die Datei vorher entsperrst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file seems to be protected by a password. Importing into Paperless only works when you unlock the file first."
          }
        }
      }
    },
