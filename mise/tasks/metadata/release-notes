#!/usr/bin/env bash
#MISE description="Write the release notes for the version being uploaded into fastlane/metadata"
set -euo pipefail

# Release notes belong to one version, but deliver reads a single release_notes.txt per locale. So
# the committed copy is `changelogs/<version>.txt` and this renders the right one into the file
# deliver expects, the same shape as metadata:review-info.
#
# What this buys: the notes for a submitted version stop changing. Drafting the next version's copy
# cannot rewrite what a build already in review says it contains, which is exactly what a single
# mutable file allowed - and did.
cd "$MISE_PROJECT_ROOT"

# The release pipeline sets ASC_APP_VERSION to the version resolved from the build's own commit,
# which is the one being submitted. Everything else - a manual `mise run metadata:upload`, a local
# lint - means the version currently in development, so the repository's own constant is the answer.
version="${ASC_APP_VERSION:-$(sed -n 's/.*marketingVersion = "\(.*\)".*/\1/p' \
  Tuist/ProjectDescriptionHelpers/Extensions/String+Extensions.swift)}"

if [ -z "$version" ]; then
  echo "error: no version - set ASC_APP_VERSION or fix marketingVersion in String+Extensions.swift" >&2
  exit 1
fi

wrote=0
for dir in fastlane/metadata/*/; do
  locale="$(basename "$dir")"
  case "$locale" in review_information) continue ;; esac

  notes="${dir}changelogs/${version}.txt"
  if [ ! -f "$notes" ]; then
    echo "error: $notes is missing" >&2
    echo "       Apple requires What's New for every version; write it before releasing $version." >&2
    exit 1
  fi

  # Checked rather than trusted: deliver uploads an empty field without complaint, and the review
  # board is a slow way to find out.
  if [ -z "$(tr -d '[:space:]' < "$notes")" ]; then
    echo "error: $notes is empty" >&2
    exit 1
  fi

  cp "$notes" "${dir}release_notes.txt"
  wrote=$((wrote + 1))
done

echo "Wrote $wrote release_notes.txt for $version (gitignored)."
