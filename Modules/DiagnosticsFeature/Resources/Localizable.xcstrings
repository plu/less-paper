    "diagnosticsClearMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird alles bisher Aufgezeichnete entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes everything recorded so far. It cannot be undone."
          }
        }
      }
