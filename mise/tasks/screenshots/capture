#!/usr/bin/env bash
#MISE description="Capture the App Store screenshots into Screenshots/Captures"
set -euo pipefail

# Runs against the fixtures in Screenshots/, never a server, so no container is needed. Refresh
# those first with Screenshots/fetch_fixtures.py if the seed has changed.
#
# Captures only. The captures are committed, so this is the expensive stage that is rarely run;
# `mise run screenshots:frame` turns them into finished images in seconds.
bundle exec fastlane screenshots

# capture_screenshots does not fail the lane when the build beneath it fails. It clears the previous
# captures first, reports success, and leaves the directory empty - so a failed run looks exactly
# like a successful one until someone opens the folder. Committed captures make that recoverable;
# this makes it visible.
expected=28
actual=$(find "$MISE_PROJECT_ROOT/Screenshots/Captures" -name '*.png' | wc -l | tr -d ' ')

if [ "$actual" -ne "$expected" ]; then
  echo "error: expected $expected captures, found $actual." >&2
  echo "Restore the previous ones with: git checkout -- Screenshots/Captures" >&2
  exit 1
fi

echo "Captured $actual screenshots."
