#!/usr/bin/env bash
#MISE description="Run tests"
set -euo pipefail
tuist install

# The nine *AppTests targets are XCUITests that boot a simulator and drive the app
# against the docker container. They are ~4% of the tests but ~70% of the test
# execution time, so they are skipped by default and run where it matters: on main,
# and on any PR shipping a build or explicitly labelled for them.
#
# Unquoted on purpose — it is either one flag or nothing.
TEST_FLAGS="--skip-ui-tests"
if [ "${CI_UI_TESTS:-}" = "true" ]; then
  TEST_FLAGS=""
fi

set +e
tuist test -d "iPhone 17 Pro" --clean $TEST_FLAGS -T test.xcresult -- -testLanguage en -testRegion DE
test_exit_code=$?
set -e

if [ -d test.xcresult ]; then
  summary=$(xcresultparser --output-format github --failed-tests-only test.xcresult)
  echo "$summary"
  if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
    echo "$summary" >> "$GITHUB_STEP_SUMMARY"
  fi
fi

exit "$test_exit_code"
