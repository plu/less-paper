#!/usr/bin/env bash
#MISE description="Set the TestFlight What to Test for the build this run uploaded"
set -euo pipefail

# The notes are the commit subjects this push delivered - honest per-build information for
# testers, not store copy, which is why generating them is fine here and would not be for the App
# Store notes. A push to main is normally one squash merge, so this is usually one line.
cd "$MISE_PROJECT_ROOT"

version="$(sed -n 's/.*marketingVersion = "\(.*\)".*/\1/p' \
  Tuist/ProjectDescriptionHelpers/Extensions/String+Extensions.swift)"
number="${GITHUB_RUN_NUMBER:?this only makes sense inside the workflow that uploaded the build}"

if [ -n "${PR_TITLE:-}" ]; then
  # A TestFlight-labelled pull request: the PR title is the summary of the whole branch.
  notes="• ${PR_TITLE}"
elif [ -n "${PUSH_BEFORE:-}" ] \
  && [ "$PUSH_BEFORE" != "0000000000000000000000000000000000000000" ] \
  && git cat-file -e "$PUSH_BEFORE" 2>/dev/null; then
  notes="$(git log --no-merges --pretty='• %s' "$PUSH_BEFORE..HEAD" | head -20)"
else
  # A force push or a shallow history leaves no usable range; the head commit is still true.
  notes="$(git log -1 --no-merges --pretty='• %s')"
fi

if [ -z "$notes" ]; then
  notes="$(git log -1 --pretty='• %s')"
fi

bundle config set --local path vendor/bundle
bundle check >/dev/null 2>&1 || bundle install

ASC_KEY_ID="$ALTOOL_KEY_ID" \
ASC_ISSUER_ID="$ALTOOL_ISSUER_ID" \
ASC_AUTH_KEY="$ALTOOL_AUTH_KEY" \
ASC_APP_VERSION="$version" \
ASC_BUILD_NUMBER="$number" \
ASC_WHAT_TO_TEST="$notes" \
  bundle exec fastlane testflight_notes
