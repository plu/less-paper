default_platform(:ios)

# Anchored to this file: fastlane runs `sh` from the directory holding the Fastfile, so a path
# relative to the repository root would resolve one level too deep.

# What deliver uploads. Written by `mise run screenshots:frame`, not by fastlane, and not committed.
SCREENSHOTS = File.expand_path("screenshots", __dir__)

# Where the capture writes, and the only committed half: an hour of simulator time is worth keeping,
# and everything rendered from it takes seconds.
CAPTURES = File.expand_path("../Screenshots/Captures", __dir__)

platform :ios do
  desc "Capture the App Store screenshots on every required device and language"
  lane :screenshots do
    clear_captures
    capture_screenshots(xcodebuild_formatter: "xcbeautify")
  end

  # Screenshots only. The build still ships through altool in mise/tasks/ci/upload, so this can
  # neither replace nor race a release, and skipping metadata keeps it away from every other field
  # on the listing.
  desc "Upload the framed screenshots to App Store Connect"
  lane :upload_screenshots do
    # sync_screenshots below is a beta deliver feature and refuses to run without this
    # acknowledgement. Set here rather than in the task so the lane works from any entry point.
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1"

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_AUTH_KEY"),
      is_key_content_base64: true
    )

    deliver(
      app_identifier: "com.aptumtek.app.Paperless",
      # Skips the HTML preview, which otherwise waits for a keypress nobody is there to give.
      force: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      screenshots_path: SCREENSHOTS,
      skip_app_version_update: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      sync_screenshots: true
    )
  end
end

# The full matrix is about to be recaptured, so anything already there is stale.
def clear_captures
  FileUtils.rm_f(Dir.glob(File.join(CAPTURES, "*", "*.png")))
end
