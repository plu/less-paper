      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Dies blendet die %lld in dieser Liste angezeigte Aufgabe aus. Das kann nicht rückgängig gemacht werden."
