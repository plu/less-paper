    "bulkEditTitleError": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ein Dokument konnte nicht aktualisiert werden. Du kannst es gleich nochmal versuchen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Dokumente konnten nicht aktualisiert werden. Du kannst es gleich nochmal versuchen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "There was one document that could not be updated. You can just try again to update it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "There were %lld documents that could not be updated. You can just try again to update them."
                }
              }
            }
          }
        }
      }
    },
