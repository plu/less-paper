    "swipeActionsTrailingFooter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu zwei Aktionen. Eine volle Wischgeste führt die erste aus. Bei Dokumenten mit Posteingangs-Tags wird das Entfernen dieser Tags automatisch an erster Stelle ergänzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to two actions. A full swipe runs the first one. On a document with inbox tags, clearing them is added automatically and comes first."
          }
        }
      }
    },
