# Apple requires one 6.9" iPhone set, and a 13" iPad set for an app that runs on iPad. Everything
# smaller is scaled from these by App Store Connect, so these two are the whole matrix.
devices([
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M5)"
])

languages([
  "en-US",
  "de-DE"
])

# Named rather than detected: fastlane looks for a project in the working directory, and the
# workspace is generated by tuist, so it is absent until ci:screenshots:capture has run generate.
workspace("LessPaper.xcworkspace")

scheme("Snapshots")

output_directory("./Screenshots/Captures")

# Cleared by the screenshots lane instead, so a subset - one language, one device - can be
# recaptured without deleting the rest. A stale image is still always wrong: the lane clears
# everything when it runs the full matrix.
clear_previous_screenshots(false)

# 9:41, full bars, full battery, instead of whatever the simulator clock happens to read.
override_status_bar(true)

concurrent_simulators(false)
