default_platform(:ios)

# Anchored to this file: fastlane runs `sh` from the directory holding the Fastfile, so a path
# relative to the repository root would resolve one level too deep.

# What deliver uploads. Written by `mise run screenshots:frame`, not by fastlane, and not committed.
SCREENSHOTS = File.expand_path("screenshots", __dir__)

# Where the capture writes, and the only committed half: an hour of simulator time is worth keeping,
# and everything rendered from it takes seconds.
CAPTURES = File.expand_path("../Screenshots/Captures", __dir__)

# The App Store listing as text, committed. Downloaded from App Store Connect rather than written
# from scratch, so what is in git starts out as what the store actually shows.
METADATA = File.expand_path("metadata", __dir__)

APP_IDENTIFIER = "com.aptumtek.app.Paperless".freeze

platform :ios do
  desc "Capture the App Store screenshots on every required device and language"
  lane :screenshots do
    clear_captures
    capture_screenshots(xcodebuild_formatter: "xcbeautify")
  end

  # Text only, and screenshots are explicitly skipped so this cannot disturb them. Like the
  # screenshot upload it touches no binary: the build ships through altool in mise/tasks/ci/upload.
  #
  # review_information is deliberately absent from git - it holds a demo password - so deliver
  # leaves that section of the listing alone unless someone has downloaded it locally first.
  desc "Upload the App Store listing text from fastlane/metadata"
  lane :upload_metadata do
    connect_api_key
    deliver(**metadata_options)
  end

  # Screenshots only. The build still ships through altool in mise/tasks/ci/upload, so this can
  # neither replace nor race a release, and skipping metadata keeps it away from every other field
  # on the listing.
  desc "Upload the framed screenshots to App Store Connect"
  lane :upload_screenshots do
    # sync_screenshots below is a beta deliver feature and refuses to run without this
    # acknowledgement. Set here rather than in the task so the lane works from any entry point.
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1"

    connect_api_key

    deliver(
      app_identifier: APP_IDENTIFIER,
      # Skips the HTML preview, which otherwise waits for a keypress nobody is there to give.
      force: true,
      overwrite_screenshots: true,
      # As above: a screenshot upload must not decide how the version rolls out.
      phased_release: true,
      run_precheck_before_submit: false,
      screenshots_path: SCREENSHOTS,
      skip_app_version_update: true,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      sync_screenshots: true
    )
  end

  # A successful Upload job in ci.yml proves altool sent the binary. It does not prove Apple
  # finished processing it, or accepted it - and deliver's own error for a build it cannot find
  # names neither the version nor the build number, so it is worth failing here instead.
  desc "Fail unless the given build is on App Store Connect and finished processing"
  # What testers read on the build in TestFlight; without it a build carries no notes at all. Set
  # after altool has uploaded: the build takes a minute or two to appear in App Store Connect, so
  # this polls for it, bounded rather than forever.
  desc "Set the What to Test notes on a just-uploaded TestFlight build"
  lane :testflight_notes do
    connect_api_key

    version = ENV.fetch("ASC_APP_VERSION")
    number = ENV.fetch("ASC_BUILD_NUMBER")
    notes = ENV.fetch("ASC_WHAT_TO_TEST")

    # Apple's limit is 4000 bytes, not characters. byteslice can cut a UTF-8 sequence in half;
    # scrub drops the fragment.
    notes = notes.byteslice(0, 3996).scrub("") + "\n…" if notes.bytesize > 4000

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("no app #{APP_IDENTIFIER} on App Store Connect") if app.nil?

    # Same trap as verify_testflight_build below: a Build's own `version` is the build number,
    # while the `version` filter means the marketing version.
    build = nil
    20.times do
      build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version)
                                          .find { |candidate| candidate.version == number }
      break if build

      UI.message("build #{version} (#{number}) is not visible yet, waiting 30s")
      sleep(30)
    end
    UI.user_error!("build #{version} (#{number}) did not appear within 10 minutes") if build.nil?

    # The same English text for every locale: this is per-build tester information, not store copy.
    localizations = build.get_beta_build_localizations
    if localizations.empty?
      Spaceship::ConnectAPI.post_beta_build_localizations(
        build_id: build.id,
        attributes: { locale: "en-US", whatsNew: notes }
      )
    else
      localizations.each do |localization|
        Spaceship::ConnectAPI.patch_beta_build_localizations(
          localization_id: localization.id,
          attributes: { whatsNew: notes }
        )
      end
    end

    UI.success("What to Test set on #{version} (#{number})")
  end

  lane :verify_testflight_build do
    connect_api_key

    version = ENV.fetch("ASC_APP_VERSION")
    number = ENV.fetch("ASC_BUILD_NUMBER")

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("no app #{APP_IDENTIFIER} on App Store Connect") if app.nil?

    # In Spaceship a Build's own `version` is CFBundleVersion - the build number - while the
    # `version` filter means the marketing version. Reading one as the other returns nothing and
    # looks exactly like a build that was never uploaded.
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version)
                                        .find { |candidate| candidate.version == number }

    UI.user_error!("no build #{version} (#{number}) on App Store Connect") if build.nil?

    unless build.processing_state == "VALID"
      UI.user_error!("build #{version} (#{number}) is #{build.processing_state}, not VALID")
    end

    UI.success("build #{version} (#{number}) is VALID")
  end

  # The binary is already on TestFlight and the listing has already been uploaded, so everything
  # here is skipped except the submission itself.
  desc "Attach an existing TestFlight build to its version and submit it for review"
  lane :submit_for_review do
    connect_api_key

    deliver(
      app_identifier: APP_IDENTIFIER,
      app_version: ENV.fetch("ASC_APP_VERSION"),
      build_number: ENV.fetch("ASC_BUILD_NUMBER"),
      # Apple approves and then waits: the version sits in Pending Developer Release until someone
      # presses Release, and only then rolls out over seven days. An approval landing at 3am does
      # not put itself in front of users.
      automatic_release: false,
      phased_release: true,
      # Skips the HTML preview, which otherwise waits for a keypress nobody is there to give.
      force: true,
      # Unlike the text-only lanes, which skip it: a failed precheck here saves a day of review,
      # where there it would only block a routine copy change.
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false,
      skip_app_version_update: false,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      # Without this deliver asks about IDFA on stdin and a CI run hangs until it times out. Export
      # compliance needs no answer here: ITSAppUsesNonExemptEncryption is false in the Info.plist.
      submission_information: { add_id_info_uses_idfa: false },
      submit_for_review: true
    )
  end
end

# deliver's own verify_only is not an option here: it hashes a binary, so it fails with "no implicit
# conversion of nil into String" when there is none. mise run metadata:lint checks the text instead.
def metadata_options
  options = {
    app_identifier: APP_IDENTIFIER,
    # deliver removes phased release when this is not set, and it logs "Removing phased release"
    # rather than asking. A text-only upload has no business changing how a version rolls out.
    phased_release: true,
    # Skips the HTML preview, which otherwise waits for a keypress nobody is there to give.
    force: true,
    # Overridden by the release pipeline, which stages the listing from the build's own
    # commit rather than from wherever main has got to. See mise/tasks/metadata/upload.
    metadata_path: ENV.fetch("ASC_METADATA_PATH", METADATA),
    run_precheck_before_submit: false,
    skip_app_version_update: true,
    skip_binary_upload: true,
    skip_metadata: false,
    # Screenshots have their own lane, and leaving them to it means neither can disturb the other.
    skip_screenshots: true
  }

  # Set only by the release pipeline. The version has to exist in App Store Connect before
  # screenshots or a build can attach to it; every other caller leaves the editable version alone.
  version = ENV["ASC_APP_VERSION"]
  return options if version.nil? || version.empty?

  options.merge(app_version: version, skip_app_version_update: false)
end

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_AUTH_KEY"),
    is_key_content_base64: true
  )
end

# The full matrix is about to be recaptured, so anything already there is stale.
def clear_captures
  FileUtils.rm_f(Dir.glob(File.join(CAPTURES, "*", "*.png")))
end
