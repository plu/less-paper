    "bulkEditMergeConfirmation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Dieser Vorgang führt %lld Dokument zu einem neuen Dokument zusammen. Die Originale bleiben erhalten."
