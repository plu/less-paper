#!/usr/bin/env bash
#MISE description="Record the App Store preview into fastlane/app_previews"
set -euo pipefail

# Runs against the fixtures in Screenshots/, never a server, so no container is needed - the same
# SNAPSHOT_MODE the screenshots use.
#
# simctl records from out here while the choreography runs in there, so the two are stitched by the
# markers AppPreviewTests prints rather than by assumption. See the design doc for why.

DEVICE="iPhone 17 Pro Max"
SCRIPTS="$MISE_PROJECT_ROOT/mise/scripts"

: "${TEST_SIMULATOR_OS:?not set - it comes from mise.toml, so run this through mise}"

# Which listing language to record. App Store Connect takes up to three previews per localisation
# and each is a separate recording: the app is launched in that language and the choreography
# navigates by that language's labels.
LOCALE="${1:-en-US}"
OUT="$MISE_PROJECT_ROOT/fastlane/app_previews/$LOCALE/01_IPHONE_67.mp4"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

tuist install
tuist generate --no-open

# Resolved to a UDID once, up front, and used everywhere below - never by "-destination
# platform=iOS Simulator,name=$DEVICE" again. Two xcodebuild invocations each resolving the name
# independently is how the two-runtimes-after-an-Xcode-upgrade hazard in AGENTS.md's "The simulator
# is declared once" turns silent here: with two iOS runtimes each carrying an "iPhone 17 Pro Max",
# build-for-testing could pick one and test-without-building the other, so simctl records an idle
# simulator while the choreography runs, unseen, on a device nothing is watching. The markers still
# print and preview_check.py still passes - it validates the container, not the content - so this
# is the one failure in the pipeline that would ship silently. A single UDID looked up once cannot
# diverge from itself.
#
# The runtime is pinned before the name is looked up, because a single UDID is only safe if it is
# the right one. `.devices[][]` flattens every runtime together and takes whichever the JSON
# happens to list first, so with 26.5 and 27.0 both installed the choice was ordering, not intent -
# and a preview recorded a whole OS out of date looks plausible enough to ship.
runtime=$(xcrun simctl list runtimes -j | jq -r --arg version "$TEST_SIMULATOR_OS" '
  [.runtimes[] | select(.isAvailable and .platform == "iOS" and .version == $version) | .identifier] | first // ""
')
[ -n "$runtime" ] || {
  echo "error: iOS $TEST_SIMULATOR_OS is not installed - run 'mise run simulators:prepare'" >&2
  exit 1
}

udid=$(xcrun simctl list devices -j | jq -r --arg runtime "$runtime" --arg name "$DEVICE" '
  [(.devices[$runtime] // [])[] | select(.name == $name and .isAvailable)] | first.udid // ""
')
[ -n "$udid" ] && [ "$udid" != "null" ] || {
  echo "error: no $DEVICE on iOS $TEST_SIMULATOR_OS - run 'mise run simulators:prepare'" >&2
  exit 1
}

# Built first and separately: a build inside the recorded window would put minutes of a static
# simulator into the file, and its duration would depend on the state of the derived data.
xcodebuild build-for-testing \
  -workspace "$MISE_PROJECT_ROOT/LessPaper.xcworkspace" \
  -scheme Snapshots \
  -destination "platform=iOS Simulator,id=$udid" | xcbeautify

xcrun simctl boot "$udid" 2>/dev/null || true
xcrun simctl bootstatus "$udid" -b

# 9:41, full bars, full battery. The Snapfile asks fastlane for this on a screenshot run; nothing
# does it for a run driven by hand.
xcrun simctl status_bar "$udid" override \
  --time "9:41" --batteryState charged --batteryLevel 100 \
  --cellularMode active --cellularBars 4 --wifiMode active --wifiBars 3

# --mask ignored gives a plain rectangle. With the mask applied the corners come out rounded and
# transparent, which is not what the store slot wants.
xcrun simctl io "$udid" recordVideo --codec h264 --mask ignored --force "$WORK/raw.mov" &
recorder=$!

# The recorder needs a moment to attach before the first frame is real.
sleep 2

set +e
TEST_RUNNER_PREVIEW_LOCALE="$LOCALE" \
xcodebuild test-without-building \
  -workspace "$MISE_PROJECT_ROOT/LessPaper.xcworkspace" \
  -scheme Snapshots \
  -destination "platform=iOS Simulator,id=$udid" \
  -only-testing:AppSnapshots/AppPreviewTests > "$WORK/xcodebuild.log" 2>&1
status=$?
set -e

# Keep recording for a moment after the choreography ends. simctl writes a container duration that
# overstates the frames it actually finalised on interrupt - measured at ~1.8s on a real run - so a
# window that fits on paper can still run past the last decodable frame and come back short. Two
# seconds of genuine tail absorbs that; it is recorded after the end marker, so the trim discards it.
sleep 2

# SIGINT rather than SIGKILL: simctl finalises the container on interrupt, and a killed recorder
# leaves an unreadable file.
kill -INT "$recorder" 2>/dev/null || true
wait "$recorder" 2>/dev/null || true

# Stamping t=0 from the moment the recorder started looked exact - the simulator shares the host's
# clock - but "started" is when we launched simctl, not when it actually began writing frames, and
# the gap between the two is however long simctl takes to attach. Measured on a real run, that
# latency was ~2.4s: the offset computed from a too-early t=0 pointed 2.4s further into the file
# than it should have, so trimming for the choreography's real duration ran off the end and ffmpeg
# quietly handed back a short file. Both "stopped" and the file's own duration are measured after
# the fact, once recordVideo has actually finished, so working backwards from the end cancels the
# attach latency out instead of guessing at it.
stopped=$(python3 -c 'import time; print(time.time())')
raw_duration=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$WORK/raw.mov")
t0=$(python3 -c 'import sys; print(float(sys.argv[1]) - float(sys.argv[2]))' "$stopped" "$raw_duration")

# || true: this is cleanup after a recording that may already have succeeded, and set -e turning a
# failure here into an EXIT trap that rm -rf's $WORK would throw away a good four-minute recording
# behind a misleading error. A cleanup step must never be able to cost more than it saves.
xcrun simctl status_bar "$udid" clear || true

if [ "$status" -ne 0 ]; then
  echo "error: the choreography failed - the last lines of its log:" >&2
  tail -40 "$WORK/xcodebuild.log" >&2
  exit "$status"
fi

# The test reports the locale it actually resolved. A mismatch means TEST_RUNNER_PREVIEW_LOCALE did
# not reach it and the default quietly took over, which produces a perfectly valid English video in
# whatever directory was asked for - the kind of failure that is only ever caught by watching.
recorded_locale=$(sed -n 's/^PREVIEW_LOCALE //p' "$WORK/xcodebuild.log" | tail -1)
if [ "$recorded_locale" != "$LOCALE" ]; then
  echo "error: asked for $LOCALE but the app recorded in '${recorded_locale:-<nothing reported>}'" >&2
  exit 1
fi

grep PREVIEW_OVERRUN "$WORK/xcodebuild.log" || true

# Assigned first, then split: a bare assignment propagates the child's exit status under set -e,
# where `read < <(...)` does not - and a swallowed failure here hands ffmpeg an empty -ss.
window=$(python3 "$SCRIPTS/preview_window.py" "$WORK/xcodebuild.log" "$t0")
read -r offset duration <<< "$window"
echo "Trimming from ${offset}s for ${duration}s."

mkdir -p "$(dirname "$OUT")"

# scale then crop, never pad: 1320x2868 scaled to width 886 is 1926, six pixels too tall, and three
# rows off each end is invisible where black bars down a store listing would not be.
#
# `fps=30` in the chain, not just `-r 30` on the encoder. simctl records variable-rate and emits no
# frame at all while the screen is still, so a beat that ends on a static view leaves a gap -
# measured at 2.4s here, from 45.1s to 47.5s, with the window ending inside it. `-r 30` sets the
# encoder's rate but leaves the last decoded frame where it is, so the mux ended 1.1s early on a
# window that was comfortably inside the recording. The fps *filter* resamples to constant rate and
# holds that frame across the gap, which is what the screen actually showed - no frame was emitted
# because nothing changed. `-shortest` truncated to 23.4s before this and is harmless after it.
#
# anullsrc supplies the silent stereo track. Apple requires an enabled audio track and a simulator
# recording has none, which is the single most common reason a preview is refused.
#
# -t after the LAST -i is load-bearing: ffmpeg applies an option to whichever input precedes it, so
# a -t between the two -i's would trim the anullsrc input rather than the output, and the real
# duration would then fall out only as a side effect of -shortest ending the file when the (untrimmed)
# audio runs dry. Placed here, after both inputs, it is an output option and trims the mux itself -
# -shortest stays as a second, independent guarantee that neither stream can outrun the other.
ffmpeg -y -loglevel error \
  -ss "$offset" -i "$WORK/raw.mov" \
  -f lavfi -i anullsrc=channel_layout=stereo:sample_rate=44100 \
  -t "$duration" \
  -vf "scale=886:-2,crop=886:1920,fps=30" \
  -c:v libx264 -profile:v high -level 4.0 -pix_fmt yuv420p \
  -r 30 -b:v 11M -maxrate 12M -bufsize 24M \
  -c:a aac -b:a 256k -ar 44100 -ac 2 \
  -movflags +faststart -shortest \
  "$OUT"

# Belt and braces on top of -shortest: this catches truncation from any cause, not only a misplaced
# -t, including a recorder that attached later than the 2s sleep above assumed. preview_check.py
# only enforces the 15-30s band, so a few seconds shaved off the end would otherwise pass it and ship.
actual=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$OUT")
python3 -c '
import sys
actual, expected = float(sys.argv[1]), float(sys.argv[2])
if abs(actual - expected) > 0.5:
    sys.exit(f"error: {sys.argv[3]} is {actual:.3f}s long, expected {expected:.3f}s - ffmpeg truncated the output")
' "$actual" "$duration" "$OUT"

python3 "$SCRIPTS/preview_check.py" "$OUT"
echo "Wrote $OUT"
