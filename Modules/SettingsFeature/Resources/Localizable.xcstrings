    "swipeActionsLeadingFooter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu zwei Aktionen. Eine volle Wischgeste führt die erste aus. In Offline steht das Entfernen immer an erster Stelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to two actions. A full swipe runs the first one. In Offline, removing the document always comes first."
          }
        }
      }
    },
