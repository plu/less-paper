      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Less Paper hat ein Trinkgeldglas in den Einstellungen. Kostenlos bleibt die App so oder so, und Trinkgeld schaltet nichts frei."
